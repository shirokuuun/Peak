<Window x:Class="UsageNotch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Peak" Icon="Assets/Notch.ico" Width="360" Height="42" MinWidth="360" MinHeight="42" MaxWidth="600" MaxHeight="560"
        AllowsTransparency="True" Background="Transparent" WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" SnapsToDevicePixels="True" UseLayoutRounding="True"
        Loaded="OnLoaded" MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave" KeyDown="OnKeyDown">
    <Window.Resources>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="MinWidth" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
                               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                               ViewportSize="{TemplateBinding ViewportSize}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False">
                                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb MinHeight="20">
                                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource CardBorderBrush}" CornerRadius="2"/></ControlTemplate></Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False">
                                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                        <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="QuietBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="QuietBorder" Property="Background" Value="{DynamicResource PanelBrush}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="QuietBorder" Property="Background" Value="{DynamicResource PanelBrush}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LimitBar" TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource LimitFillBrush}"/>
            <Setter Property="Background" Value="{DynamicResource TrackBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track" ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid ClipToBounds="True">
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="24">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="{Binding IslandHeaderHeight}"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Grid.Row="1" x:Name="ExpandedContent" Margin="4,0,4,6" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                    <ScrollViewer x:Name="UsageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Providers}" Visibility="{Binding UsageVisibility}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" Padding="14" Margin="0,0,0,6">
                                            <StackPanel>
                                                <Grid Height="26" ToolTip="{Binding StatusText}">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
<TextBlock Text="{Binding HeadingText}" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding PlanText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                </Grid>
                                                <TextBlock Text="{Binding NoticeText}" Style="{StaticResource OptionalText}" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="15" Padding="16,15,16,3" Margin="0,1,0,0">
                                                    <ItemsControl ItemsSource="{Binding Windows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="0,0,0,18" ToolTip="{Binding ResetText}">
                                                                    <TextBlock Text="{Binding LimitLabel}" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,9" TextTrimming="CharacterEllipsis"/>
                                                                    <Grid Margin="0,0,0,8">
                                                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding ResetSummary}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding LeftText}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                                                    </Grid>
                                                                    <ProgressBar Style="{StaticResource LimitBar}" Height="6" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" BorderThickness="0"/>
                                                                    <TextBlock Text="{Binding QuantityText}" Style="{StaticResource OptionalText}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,5,0,0"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Visibility="{Binding TasksVisibility}" Background="Transparent" Padding="14" Margin="0,0,0,6">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Codex tasks" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button Content="×" Style="{StaticResource QuietButton}" Click="OnCollapse" HorizontalAlignment="Right" ToolTip="Collapse" AutomationProperties.Name="Collapse notch"/>
                                    </Grid>
                                    <TextBlock Text="{Binding TaskStatus}" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <TextBlock Text="{Binding EmptyTaskText}" Style="{StaticResource OptionalText}" Foreground="{DynamicResource TextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,12"/>
                                    <ItemsControl ItemsSource="{Binding Tasks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="13" Padding="14" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                                        <TextBlock Text="{Binding Project}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,6" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding StateText}" Foreground="{Binding Brush}" FontSize="11" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Activity}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,4,0,8" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource OptionalText}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,0,0,6"/>
                                                        <Grid>
                                                            <TextBlock Text="{Binding AgeText}" Foreground="{DynamicResource MutedBrush}" FontSize="9" VerticalAlignment="Center"/>
                                                            <Button Content="Open chat" Command="{Binding OpenChatCommand}" HorizontalAlignment="Right" FontSize="10" Padding="8,5" AutomationProperties.Name="Open this chat in Codex"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding OpenError}" Style="{StaticResource OptionalText}" Foreground="{DynamicResource CriticalBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="1" Margin="10,2,4,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ItemsControl ItemsSource="{Binding FooterTasks}" HorizontalAlignment="Left" VerticalAlignment="Center" MaxWidth="354" ClipToBounds="True">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.ShowTasksCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource QuietButton}" Width="164" Padding="5,5" Margin="0,0,8,0" ToolTip="{Binding Title}" AutomationProperties.Name="View Codex task activity">
                                        <Grid Width="154">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="10" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding FooterLabel}" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding FooterState}" Foreground="{Binding FooterBrush}" FontSize="12" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="↻" Style="{StaticResource QuietButton}" Command="{Binding RefreshCommand}" FontSize="17" ToolTip="{Binding UpdatedText}" AutomationProperties.Name="Refresh usage and tasks"/>
                            <Button Content="{Binding TaskSwitchText}" Style="{StaticResource QuietButton}" Command="{Binding ToggleTasksCommand}" Foreground="{Binding CompactActivityBrush}" FontSize="11" AutomationProperties.Name="Switch between limits and tasks"/>
                            <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource QuietButton}" Command="{Binding SettingsCommand}" FontSize="12" ToolTip="Settings" AutomationProperties.Name="Settings"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
        <Border x:Name="IslandHeader" Height="{Binding IslandHeaderHeight}" VerticalAlignment="Top" Background="{DynamicResource SurfaceBrush}" CornerRadius="24"/>
        <Grid Height="42" VerticalAlignment="Top" Margin="18,0" Background="Transparent" MouseLeftButtonUp="OnHeaderClick"
              ToolTip="{Binding RecoveryHint}"
              AutomationProperties.Name="Usage summary. Click to show details.">
            <Grid.ColumnDefinitions><ColumnDefinition Width="66"/><ColumnDefinition Width="*"/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding CodexTooltip}">
                <Grid Width="22" Height="22">
                    <Ellipse Stroke="{DynamicResource TrackBrush}" StrokeThickness="2" Margin="2"/>
                    <Path Data="{Binding CodexRing}" Stroke="{Binding CodexBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <TextBlock Text="Cx" Foreground="{DynamicResource TextBrush}" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Codex"/>
                </Grid>
                <TextBlock Text="{Binding CodexRemainingText}" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="330" Margin="8,0" ToolTip="{Binding CompactTooltip}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Ellipse Width="6" Height="6" Fill="{Binding IslandActivityBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBlock Grid.Column="1" Text="{Binding CompactTitle}" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding IslandOtherTasks}" Style="{StaticResource OptionalText}" Foreground="{Binding IslandActivityBrush}" FontSize="10" Margin="7,0,0,0" VerticalAlignment="Center" ToolTip="Other active chats. Open Tasks to see all chats."/>
            </Grid>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="{Binding ClaudeTooltip}">
                <TextBlock Text="{Binding ClaudeRemainingText}" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,7,0" VerticalAlignment="Center"/>
                <Grid Width="22" Height="22">
                    <Ellipse Stroke="{DynamicResource TrackBrush}" StrokeThickness="2" Margin="2"/>
                    <Path Data="{Binding ClaudeRing}" Stroke="{Binding ClaudeBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <TextBlock Text="Cl" Foreground="{DynamicResource TextBrush}" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Claude"/>
                </Grid>
            </StackPanel>
        </Grid>
        <Grid Height="36" VerticalAlignment="Top" Margin="24,39,24,0" Visibility="{Binding IslandActivityVisibility}"
              Background="Transparent" MouseLeftButtonUp="OnHeaderClick" ToolTip="{Binding CompactTooltip}"
              AutomationProperties.Name="Current task activity and elapsed time">
            <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding IslandActivityText}" Foreground="{Binding IslandActivityBrush}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <TextBlock Grid.Column="1" Text="{Binding IslandElapsedText}" Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center"
                           ToolTip="Time since the observed turn start, including waiting. When the start was not observed, shows observation age."/>
            </Grid>
            <Grid Grid.Row="1" Height="2" VerticalAlignment="Top" Margin="0,5,0,0" ClipToBounds="True" Visibility="{Binding IslandProgressVisibility}"
                  ToolTip="Activity indicator. Completion percentage is unavailable.">
                <Border Background="{DynamicResource TrackBrush}" CornerRadius="1"/>
                <Rectangle Width="90" HorizontalAlignment="Left" Fill="{Binding IslandActivityBrush}" RadiusX="1" RadiusY="1">
                    <Rectangle.RenderTransform><TranslateTransform X="230"/></Rectangle.RenderTransform>
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsIslandAnimating}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="ActivitySweep">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                 From="-90" To="552" Duration="0:0:1.8"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="ActivitySweep"/></DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>
            </Grid>
        </Grid>
        <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0.6" CornerRadius="24" IsHitTestVisible="False"/>
    </Grid>
</Window>
