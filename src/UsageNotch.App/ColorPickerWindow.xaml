<Window x:Class="UsageNotch.App.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Peak color" Icon="Assets/Notch.ico" Width="410" Height="750"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Topmost="True"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
        Style="{StaticResource PeakWindowStyle}">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SettingsStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,8">
                <TextBlock Text="Make Peak yours" FontSize="23" FontWeight="Bold"/>
                <TextBlock Text="Pick any color. Text adjusts automatically." Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,16"/>
                <Grid x:Name="ColorField" Height="136" ClipToBounds="True" Cursor="Cross"
                      MouseLeftButtonDown="OnPaletteDown" MouseMove="OnPaletteMove" MouseLeftButtonUp="OnPaletteUp" SizeChanged="OnPaletteSizeChanged"
                      AutomationProperties.Name="Color palette. Use the sliders below for keyboard selection.">
                    <Border x:Name="HueField"/>
                    <Border>
                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="White" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background>
                    </Border>
                    <Border>
                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="Black" Offset="1"/></LinearGradientBrush></Border.Background>
                    </Border>
                    <Canvas IsHitTestVisible="False">
                        <Ellipse x:Name="SelectionOutline" Width="16" Height="16" Stroke="Black" StrokeThickness="4"/>
                        <Ellipse x:Name="SelectionMarker" Width="16" Height="16" Stroke="White" StrokeThickness="2"/>
                    </Canvas>
                </Grid>
                <TextBlock Text="Hue" Margin="0,12,0,4"/>
                <Grid Height="24">
                    <Border Margin="0,5" CornerRadius="5">
                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="Red" Offset="0"/><GradientStop Color="Yellow" Offset="0.1667"/><GradientStop Color="Lime" Offset="0.3333"/><GradientStop Color="Cyan" Offset="0.5"/><GradientStop Color="Blue" Offset="0.6667"/><GradientStop Color="Magenta" Offset="0.8333"/><GradientStop Color="Red" Offset="1"/></LinearGradientBrush></Border.Background>
                    </Border>
                    <Slider x:Name="Hue" Minimum="0" Maximum="360" SmallChange="1" LargeChange="15" Foreground="Transparent" Background="Transparent" ValueChanged="OnSliderChanged" AutomationProperties.Name="Hue"/>
                </Grid>
                <Grid Margin="0,8,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Saturation"/><Slider x:Name="Saturation" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" ValueChanged="OnSliderChanged" AutomationProperties.Name="Saturation"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Brightness"/><Slider x:Name="Brightness" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" ValueChanged="OnSliderChanged" AutomationProperties.Name="Brightness"/></StackPanel>
                </Grid>
                <TextBlock Text="Quick colors" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,7"/>
                <UniformGrid x:Name="Presets" Columns="8" Margin="0,0,0,14"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Hex" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox x:Name="HexInput" Grid.Column="1" Padding="8" MaxLength="7" TextChanged="OnHexChanged" AutomationProperties.Name="Hex color"/>
                    <TextBlock x:Name="RgbReadout" Grid.Column="2" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
                <TextBlock x:Name="ColorError" Foreground="{DynamicResource CriticalBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,10"/>
                <TextBlock Text="Color preview" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,7"/>
                <Border x:Name="PreviewSurface" CornerRadius="18" Padding="15" BorderThickness="1">
                    <StackPanel>
                        <Grid><TextBlock x:Name="PreviewTitle" Text="Peak" FontSize="15" FontWeight="Bold"/><TextBlock x:Name="PreviewValue" Text="68% remaining · sample" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                        <Border x:Name="PreviewCard" CornerRadius="9" Padding="10" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock x:Name="PreviewSecondary" Text="Next reset in 2h 18m" FontSize="11"/>
                                <Border x:Name="PreviewTrack" Height="5" CornerRadius="3" Margin="0,8,0,0"><Border x:Name="PreviewFill" HorizontalAlignment="Left" Width="170" CornerRadius="3"/></Border>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock x:Name="PreviewSuccess" Text="● Working" FontSize="10"/><TextBlock x:Name="PreviewWarning" Text="● Review" FontSize="10" Margin="15,0,0,0"/><TextBlock x:Name="PreviewCritical" Text="● Critical" FontSize="10" Margin="15,0,0,0"/></StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="ContrastNote" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,9,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" IsCancel="True" Click="OnCancel" Margin="0,0,8,0"/>
            <Button x:Name="UseColor" Content="Use color" Click="OnUseColor" IsDefault="True" Background="#F0F0EE" Foreground="#161616"/>
        </StackPanel>
    </Grid>
</Window>
