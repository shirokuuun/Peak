<Window x:Class="UsageNotch.App.ProviderSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect provider — Peak" Width="530" Height="440" MinWidth="430" MinHeight="380"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="#151515" Foreground="#F5F5F5"
        ShowInTaskbar="False" Style="{StaticResource PeakWindowStyle}">
    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="TrackBrush" Color="#383838"/>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="Heading" FontSize="26" FontWeight="Bold" Text="Connect your provider"/>
            <TextBlock Text="Install once. Sign in with your own account." Foreground="#BDBDBD" Margin="0,8,0,20" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="#242424" CornerRadius="14" Padding="20">
                    <StackPanel>
                        <TextBlock x:Name="StepTitle" Text="Checking your setup…" FontSize="17" FontWeight="Bold"/>
                        <TextBlock x:Name="StatusText" Text="Looking for an existing installation and login." Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#CCCCCC" LineHeight="23" AutomationProperties.LiveSetting="Polite"/>
                        <ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True" Margin="0,18,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="Peak is free. Provider accounts and subscriptions are separate. Install and sign-in actions take effect immediately; Cancel does not uninstall a provider or undo its login." Foreground="#BDBDBD" Margin="3,18,3,10" TextWrapping="Wrap" LineHeight="21"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="70" Margin="0,0,8,0"/>
            <Button Content="Check again" x:Name="Retry" Click="OnRetry" MinWidth="90" Margin="0,0,8,0"/>
            <Button Content="Connect" x:Name="Primary" Click="OnPrimary" MinWidth="120" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
