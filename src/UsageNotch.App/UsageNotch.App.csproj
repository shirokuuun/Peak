<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Notch.ico</ApplicationIcon>
    <AssemblyName>Peak</AssemblyName>
    <Product>Peak</Product>
    <Title>Peak</Title>
    <Description>Local AI subscription usage and task activity in your Windows notch.</Description>
    <RootNamespace>UsageNotch.App</RootNamespace>
    <Version>1.0.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Notch.ico" />
    <Resource Include="Policies\*.md" />
    <Content Include="Policies\*.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="publishing.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <ProjectReference Include="..\UsageNotch.Core\UsageNotch.Core.csproj" />
    <ProjectReference Include="..\UsageNotch.Providers\UsageNotch.Providers.csproj" />
    <ProjectReference Include="..\UsageNotch.Windows\UsageNotch.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Notifications" Version="7.1.2" />
  </ItemGroup>

</Project>
